{
  "name": "dsh-vim-control",
  "version": "0.1.0",
  "private": true,
  "description": "Vim-inspired modal navigation for the DeepSeek Harness Web GUI: conversations, chat rows, and subagents",
  "type": "module",
  "icon": "./icon.svg",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "meta": {
    "title": "Vim control",
    "description": "Modal keyboard navigation for the Web GUI: move by rows, jump between conversations and subagents, and drive the shell from a command line."
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client",
    "vim",
    "keyboard",
    "navigation"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc --project tsconfig.json && tsc --project tsconfig.client.json && node scripts/build-client.mjs",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.client.json --noEmit",
    "pretest": "pnpm build",
    "test": "node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "~18.3.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
