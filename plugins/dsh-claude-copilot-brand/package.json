{
  "name": "dsh-claude-copilot-brand",
  "version": "0.1.0",
  "private": true,
  "description": "Rebrands the Web sidebar: the OpenAI logomark and the name \"Claude Copilot\"",
  "type": "module",
  "icon": "./icon.svg",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "icon.svg",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "client",
    "sidebar",
    "brand"
  ],
  "license": "MIT",
  "scripts": {
    "build": "node --check index.js && node --check client.js",
    "typecheck": "node --check index.js && node --check client.js",
    "test": "node --check index.js && node --check client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
