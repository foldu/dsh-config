# --- DSH runtime state: private, churning, machine-specific ---
/sessions/
/storages/
/logs/
/.anonymous-user-id
# Session attachments (pasted/rendered images), the attachment request cache,
# and the DeepSeek provider's uploaded-file index.
/attachments/
/cache/
/llm-deepseek/

# --- decrypted secrets (the sops copies ARE tracked) ---
/.credentials.yaml
.env
.env.*

# --- installed packages ---
node_modules/
.pnpm-store/
profiles/*/.plugin-manager/

# --- build residue ---
*.tsbuildinfo
coverage/
