# --- DSH runtime state: private, churning, machine-specific ---
/sessions/
/storages/
/logs/
/.anonymous-user-id
# Session attachments (pasted/rendered images), the attachment request cache,
# and the per-provider uploaded-file indexes the LLM adapters keep beside their
# own state (e.g. llm-deepseek/files-v3.json). `/llm-*/` rather than the one
# directory seen so far: the index path is each adapter's own choice, not a
# shared convention.
/attachments/
/cache/
/llm-*/

# --- machine-local overlay: internal hostnames, per-host rows ---
# The home-layer patch the loader applies after the profile layer. Tracked
# config stays generic enough to publish; this file carries what only exists on
# this network.
/cordis.patch.yml
# Documents this lab's own GitLab runners. Useful here, meaningless (and
# internal-hostname-bearing) anywhere else.
/skills/lab-gitlab-ci/

# --- decrypted secrets (the sops copies ARE tracked) ---
/.credentials.yaml
.env
.env.*

# --- installed packages ---
node_modules/
.pnpm-store/
profiles/*/.plugin-manager/

# --- build residue ---
*.tsbuildinfo
coverage/
